{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theastraway/mind",
  "title": "MIND",
  "description": "MIND knowledge-graph memory for agents. 44 tools: CRM, Life, MoneyMIND, Budget, Sheets, Email, Sign.",
  "repository": {
    "url": "https://github.com/theastraway/mind-mcp-server",
    "source": "github"
  },
  "version": "0.29.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@astramindapp/mcp-server",
      "version": "0.29.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MIND_API_KEY",
          "description": "Your MIND Developer API key (get one at m-i-n-d.ai)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "MIND_BASE_URL",
          "description": "MIND API base URL",
          "isRequired": false,
          "default": "https://m-i-n-d.ai"
        }
      ]
    }
  ]
}
